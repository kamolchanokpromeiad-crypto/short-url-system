&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3f7fc;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="urls"><mxGeometry y="136" width="340" height="32" as="geometry"/></mxCell><mxCell id="urls_4" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;expires_at : &lt;font color=&quot;#555555&quot;&gt;TIMESTAMPTZ NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="urls"><mxGeometry y="168" width="340" height="32" as="geometry"/></mxCell><mxCell id="urls_5" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;created_at : &lt;font color=&quot;#555555&quot;&gt;TIMESTAMPTZ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3f7fc;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="urls"><mxGeometry y="200" width="340" height="32" as="geometry"/></mxCell><mxCell id="clicks" value="clicks (ประวัติการคลิก)" style="swimlane;fontStyle=1;startSize=40;fillColor=#2f5d8a;fontColor=#ffffff;strokeColor=#2f5d8a;strokeWidth=2;fontSize=16;html=1;childLayout=stackLayout;horizontal=1;horizontalStack=0;resizeParent=1;collapsible=0;" vertex="1" parent="1"><mxGeometry x="920" y="110" width="320" height="264" as="geometry"/></mxCell><mxCell id="clicks_0" value="&lt;b&gt;PK&lt;/b&gt;&amp;nbsp;&amp;nbsp;&lt;u&gt;&lt;b&gt;id&lt;/b&gt;&lt;/u&gt; : &lt;font color=&quot;#555555&quot;&gt;BIGSERIAL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="40" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_1" value="&lt;b&gt;FK&lt;/b&gt;&amp;nbsp;&amp;nbsp;url_id : &lt;font color=&quot;#555555&quot;&gt;INTEGER&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3f7fc;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="72" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_2" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;source : &lt;font color=&quot;#555555&quot;&gt;VARCHAR(10)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="104" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_3" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;ip_address : &lt;font color=&quot;#555555&quot;&gt;VARCHAR(45)&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3f7fc;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="136" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_4" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;user_agent : &lt;font color=&quot;#555555&quot;&gt;TEXT&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="168" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_5" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;referrer : &lt;font color=&quot;#555555&quot;&gt;TEXT NULL&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#f3f7fc;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="200" width="320" height="32" as="geometry"/></mxCell><mxCell id="clicks_6" value="&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;clicked_at : &lt;font color=&quot;#555555&quot;&gt;TIMESTAMPTZ&lt;/font&gt;" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=#ffffff;strokeColor=none;fontSize=14;fontFamily=Courier New;" vertex="1" parent="clicks"><mxGeometry y="232" width="320" height="32" as="geometry"/></mxCell><mxCell id="r0" value="สร้าง (creates)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.6;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="users_0" target="urls_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="r1" value="ถูกคลิก (has)" style="edgeStyle=orthogonalEdgeStyle;html=1;rounded=0;startArrow=ERmandOne;endArrow=ERzeroToMany;startFill=0;endFill=0;strokeWidth=1.6;fontSize=13;exitX=1;exitY=0.5;entryX=0;entryY=0.5;labelBackgroundColor=#ffffff;" edge="1" parent="1" source="urls_0" target="clicks_1"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="notes" value="PK = Primary Key · FK = Foreign Key · UQ = Unique&lt;br&gt;ความสัมพันธ์แบบ Crow&amp;#x27;s Foot:  ||  = 1 (ต้องมีเสมอ)    o&amp;lt;  = 0 ถึงหลายรายการ&lt;br&gt;urls.user_id → users.id  ·  clicks.url_id → urls.id (ON DELETE CASCADE: ลบลิงก์แล้วประวัติคลิกของลิงก์นั้นถูกลบตาม)&lt;br&gt;clicks.source = แหล่งที่มาของการเปิด (link / qr)  ·  จำนวนคลิกของแต่ละลิงก์ = COUNT(clicks) ไม่เก็บซ้ำในตาราง urls" style="text;html=1;align=left;verticalAlign=top;fontSize=13;fontColor=#444444;" vertex="1" parent="1"><mxGeometry x="60" y="410" width="1160" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>