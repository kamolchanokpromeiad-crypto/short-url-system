<mxfile host="app.diagrams.net"><diagram name="DFD Level 0" id="dfd0full"><mxGraphModel grid="1" gridSize="10" guides="1" page="1" pageWidth="1820" pageHeight="1060" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="title" value="Data Flow Diagram Level 0 : ระบบ Short URL" style="text;html=1;align=center;fontSize=26;fontStyle=1;" vertex="1" parent="1"><mxGeometry x="0" y="25" width="1820" height="45" as="geometry"/></mxCell><mxCell id="user" value="ผู้ใช้งาน&lt;br&gt;(User)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2f5d8a;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1d3a57;" vertex="1" parent="1"><mxGeometry x="40" y="130" width="190" height="820" as="geometry"/></mxCell><mxCell id="visitor" value="ผู้เข้าชมลิงก์&lt;br&gt;(Visitor)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#e8f1fb;strokeColor=#2f5d8a;strokeWidth=2;fontSize=18;fontStyle=1;fontColor=#1d3a57;" vertex="1" parent="1"><mxGeometry x="1620" y="590" width="170" height="150" as="geometry"/></mxCell><mxCell id="p1" value="&lt;b&gt;1.0&lt;/b&gt;&lt;hr&gt;&lt;b&gt;จัดการสมาชิก&lt;/b&gt;&lt;br&gt;&lt;span style=&quot;font-size:12px&quot;&gt;(สมัคร / เข้าสู่ระบบ)&lt;/span&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff4e0;strokeColor=#b9770e;strokeWidth=2;fontSize=16;fontColor=#5a3a05;" vertex="1" parent="1"><mxGeometry x="532" y="122" width="176" height="176" as="geometry"/></mxCell><mxCell id="p2" value="&lt;b&gt;2.0&lt;/b&gt;&lt;hr&gt;&lt;b&gt;สร้าง&lt;/b&gt;&lt;br&gt;&lt;b&gt;Short URL&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff4e0;strokeColor=#b9770e;strokeWidth=2;fontSize=16;fontColor=#5a3a05;" vertex="1" parent="1"><mxGeometry x="532" y="352" width="176" height="176" as="geometry"/></mxCell><mxCell id="p3" value="&lt;b&gt;3.0&lt;/b&gt;&lt;hr&gt;&lt;b&gt;สร้าง&lt;/b&gt;&lt;br&gt;&lt;b&gt;QR Code&lt;/b&gt;" style="ellipse;whiteSpace=wrap;html=1;aspect=fixed;fillColor=#fff4e0;stroke