# คัดลอกไฟล์นี้เป็น .env แล้วแก้ค่าให้ตรงกับเครื่องของคุณ (ห้าม push ไฟล์ .env ขึ้น Git)

# พอร์ตของ backend
PORT=4000

# ที่อยู่ของ backend ใช้สร้างลิงก์สั้นและ QR Code (ตอน deploy เปลี่ยนเป็น URL จริงของโฮสต์)
BASE_URL=http://localhost:4000

# ที่อยู่ของ frontend ที่อนุญาตให้เรียก API (คั่นหลายค่าด้วย ,)
FRONTEND_URL=http://localhost:5173

# คีย์ลับสำหรับเซ็น token ล็อกอิน ตั้งเป็นข้อความสุ่มยาวๆ
JWT_SECRET=change-me-to-a-long-random-string

# ---- ฐานข้อมูล: เลือกใช้แบบใดแบบหนึ่ง ----
# แบบที่ 1: รันในเครื่อง
PGHOST=localhost
PGPORT=5432
PGDATABASE=short_url
PGUSER=postgres
PGPASSWORD=your-password

# แบบที่ 2: ฐานข้อมูลบนคลาวด์ (Neon / Render / Supabase) ใช้บรรทัดนี้แทน และตั้ง DB_SSL=true
# DATABASE_URL=postgresql://user:password@host/dbname
# DB_SSL=true
